{
  "productName": "nagents",
  "version": "0.1.0",
  "identifier": "com.nagents.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' http://localhost:5180; connect-src 'self' http://127.0.0.1:3335 http://localhost:3335 http://localhost:5180; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:5180; style-src 'self' 'unsafe-inline' http://localhost:5180"
    },
    "windows": [
      {
        "label": "main",
        "title": "nagents",
        "width": 340,
        "height": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../config.yaml",
      "../sources/**/*"
    ]
  }
}